<header class='pc-header'>
  <div class='header-inner'>
    <div class='main-header'>
      <h1 class='icon'>
        <%= link_to image_tag("furima-logo-color.png", class:"furima-logo"), root_path %>
      </h1>
      <div class='search-box'>
        <form action="#" method="get">
          <input class='search-input' name="keyword" id="keyword" placeholder='キーワードから探す'>
          <button class="search-button">
            <%= image_tag "search.png", class:"search-icon" %>
          </button>
        </form>
      </div>
    </div>
    <div class='nav'>
      <ul class='lists-left'>
        <li><%= link_to 'カテゴリー', '#', class: "category-list" %></li>
        <li><%= link_to 'ブランド', '#', class: "brand-list" %></li>
      </ul>
      <ul class='lists-right'>
        <% if user_signed_in? %>
          <li><%= link_to current_user.nickname, "#", class: "user-nickname" %></li>
          <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "logout" %></li>
        <% else %>
          <li><%= link_to "ログイン", new_user_session_path, class: "login" %></li>
          <li><%= link_to "新規登録", new_user_registration_path, class: "sign-up" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</header>

